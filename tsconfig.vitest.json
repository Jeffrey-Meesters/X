{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    // Tests need both worlds: they render DOM components and, for the
    // animation convention checks, read the source files off disk.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  },
  "include": ["src/**/*.test.ts", "src/test-setup.ts", "vitest.config.ts"]
}
